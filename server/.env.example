# Domain for HTTPS (used by docker-compose.yml and Caddy).
BACKEND_DOMAIN=your-backend.example

# Required. There is no unauthenticated mode: the service won't start without these.
# Generate each value with: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
ACCESS_KEYS=
TOKEN_SECRET=
# Exact origins of your Nuvio Web frontend, comma separated. Wildcards are rejected.
ALLOWED_ORIGINS=https://your-nuvio-web.example

# Networking
HOST=0.0.0.0
PORT=8787
# Set both when running behind an HTTPS reverse proxy.
TRUST_PROXY=true
PUBLIC_BASE_URL=https://your-backend.example

# Features
ENABLE_TORRENTS=true
# Re-encoding video is CPU heavy. Without it, HEVC on devices that can't decode it is refused.
ALLOW_TRANSCODE=false

# Storage. Use a disk with room for MAX_CACHE_GB.
CACHE_DIR=/data/cache
MAX_CACHE_GB=40
MAX_FILE_GB=40

# Resource limits
MAX_SESSIONS=4
MAX_TORRENTS=3
MAX_FFMPEG_PROCESSES=2
TORRENT_MAX_CONNECTIONS=55
# Fixed peer port. Matches the port published in docker-compose.yml.
TORRENT_PORT=6881
# In KB per second. -1 means unlimited. Uploading is how a swarm works, so 0 can starve downloads.
TORRENT_DOWNLOAD_LIMIT_KBPS=-1
TORRENT_UPLOAD_LIMIT_KBPS=512

# Cleanup
SESSION_IDLE_MINUTES=10
TORRENT_LINGER_MINUTES=3
METADATA_TIMEOUT_SECONDS=120
PROBE_TIMEOUT_SECONDS=180

# Tokens
SESSION_TTL_HOURS=720
MEDIA_TOKEN_TTL_HOURS=12

# Leave off in production. These exist for local tests only: they allow internal addresses.
ALLOW_PRIVATE_PEERS=false
ALLOW_PRIVATE_UPSTREAMS=false

# Frontend build settings. Every value here ends up in the public nuvio.env.js, so nothing secret
# belongs in this file. Copy per environment: .env.development, .env.staging, .env.production.
# scripts/web-build.mjs reads them from the environment (or local.properties).

# Nuvio account server. Upstream keeps these out of its repository. See docs/web/DEPLOYMENT.md.
NUVIO_SUPABASE_URL=
NUVIO_SUPABASE_ANON_KEY=
NUVIO_SUPABASE_FALLBACK_URL=
TV_LOGIN_WEB_BASE_URL=https://nuvio.tv/tv-login
DEVICE_LOGIN_WEB_BASE_URL=https://nuvio.tv/link

# Optional. Pre-fills the backend URL in Settings. The access key is always entered by the user.
NUVIO_BACKEND_URL=

# GPL-3.0: if you share this app with anyone, link to where they can get its source code.
NUVIO_WEB_SOURCE_URL=
